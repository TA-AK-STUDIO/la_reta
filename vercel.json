{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/leaderboard.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/leaderboard", "destination": "/api/leaderboard" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
